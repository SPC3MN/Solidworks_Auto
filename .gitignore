# SolidWorks temp/lock files
~$*
*.SLDBAK

# Unvalidated build output
projects/*/.staging/
products/*/parts/*/.staging/

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
Thumbs.db

# Rendering: large, rebuildable intermediates (manifest, settings, reports and finals are kept)
*/*/render/blender/
*/*/render/previews/
*/*/render/export/step/
*/*/render/export/geometry/
*.blend1
config/render.local.json

# FreeCAD backups
*.FCBak
