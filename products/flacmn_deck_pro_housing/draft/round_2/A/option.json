{
 "schema_version": "1.0",
 "name": "Two folded shells: tray + U-cover",
 "summary": "Round 2: 46 x 5 knob caps. Two hand-folded 1.0 mm aluminium sheets. The tray (base, front wall with screen and knob, rear wall with USB-C, RCA and jack) carries everything; the U-cover (top and both sides) drops over it and takes 4 screws into clinch nuts in the tray's tabs. USB and Ethernet face the left side; the side knob and a Wi-Fi slot are on the right side; the microSD is reached with the cover off. Processor heat goes through a pad under the Pi into the base.",
 "architecture": {
  "mechanism": "Pi + DAC stack slides rearward on the base until the RCA barrels pass the rear wall, then 4 screws from below; cover drops on, 4 side screws",
  "layout": "Pi flat, USB-C long side at the rear, USB/Ethernet edge flush with the left side, SD end at the right; screen and front encoder in the 12 mm zone behind the front wall",
  "load_path": "knobs -> walls -> base -> feet -> shelf",
  "process": "laser-cut flat, 6 + 2 hand folds on perforated lines (UNTESTED recipe)"
 },
