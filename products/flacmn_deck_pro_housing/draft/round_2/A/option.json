  {
   "id": "jumpers_roof",
   "lhs": "zht + 2.5 + jumper_h + wire_bend",
   "op": "<=",
   "rhs": "H - t",
   "why": "Jumper housings on the pass-through header and their wire bends clear the top"
  },
  {
