   "lhs": "encS_y + knob_d/2",
   "op": "<=",
   "rhs": "D - 3",
   "why": "Side knob cap inside the side face"
  },
  {
   "id": "knob_shaft",
   "lhs": "bush_out + knob_gap + knob_h",
   "op": "<=",
   "rhs": "20 - t",
   "why": "Shaft (20 past the body) is long enough for the cap; cut to length"
  },
  {
   "id": "enc_side_vs_header",
   "lhs": "encS_y - enc_w/2",
   "op": ">=",
   "rhs": "py0 + 6 + 2",
   "why": "Side encoder clears the jumper row on the header"
  },
  {
   "id": "enc_side_roof",
   "lhs": "encS_z + enc_h/2",
   "op": "<=",
   "rhs": "H - t - 1",
   "why": "Side encoder body under the top"
  },
  {
   "id": "enc_front_vs_screen",
   "lhs": "encF_x - enc_w/2",
   "op": ">=",
   "rhs": "scr_x0 + scr_l + 1",
   "why": "Front encoder body clears the screen module"
  },
  {
   "id": "knob_vs_window",
   "lhs": "encF_x - knob_d/2",
   "op": ">=",
   "rhs": "win_x + win_w/2 + 3",
   "why": "Front knob cap clears the screen window"
  },
  {
   "id": "knob_vs_edge",
   "lhs": "encF_x + knob_d/2",
   "op": "<=",
   "rhs": "W - 3",
   "why": "Front knob cap inside the front face"
  },
  {
   "id": "side_knob_vs_front",
   "lhs": "encS_y - knob_d/2",
   "op": ">=",
   "rhs": 3,
   "why": "Side knob cap inside the side face"
  },
  {
   "id": "screen_in_face",
   "lhs": "scr_z + scr_h/2",
   "op": "<=",
   "rhs": "H - t - 1",
   "why": "Screen module fits the front wall height"
  },
  {
   "id": "screen_over_base",
   "lhs": "scr_z - scr_h/2",
   "op": ">=",
   "rhs": "t + 1",
   "why": "Screen module clears the base"
  },
  {
   "id": "pi_fits_width",
   "lhs": "px1 + sd_oh",
   "op": "<=",
   "rhs": "W - t - 0.3",
   "why": "Pi with the SD card fits between the sides"
  },
  {
   "id": "usbc_under_rca",
   "lhs": "usbc_z + usbc_h/2 + 3",
   "op": "<=",
   "rhs": "rca_z - rca_hole/2",
   "why": "USB-C opening and RCA holes keep a 3 mm web"
  },
  {
   "id": "tabs_over_usb",
   "lhs": "zpt + 16 + 2",
   "op": "<=",
   "rhs": "H - t - top_gap - tab_h",
   "why": "Cover-screw tabs sit above the USB jacks"
  },
  {
   "id": "nut_vs_screen",
   "lhs": "t + gap + 1 + 1.5 + 0.5",
   "op": "<=",
   "rhs": "scr_x0",
   "why": "Front-left clinch nut clears the screen module"
  },
  {
   "id": "nut_catches",
   "lhs": "t + 2.5",
   "op": "<=",
   "rhs": 7,
   "why": "Encoder bushing (7) takes the wall, washer and M7 nut"
  }
