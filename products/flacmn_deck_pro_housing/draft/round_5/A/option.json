 "fit": [
  {
   "id": "jumpers_roof",
   "lhs": "zht + 2.5 + jumper_h + wire_bend",
   "op": "<=",
   "rhs": "H - 2*t - 1.5",
   "why": "Encoder wires clear the top flange's nut"
  },
  {
   "id": "rear_recessed",
   "lhs": "py1 + rca_len",
   "op": "<=",
   "rhs": "D - t - 0.5",
   "why": "RCA barrels stop inside the back panel"
  },
  {
   "id": "rca_web",
   "lhs": "rca_x1 - rca_x2 - rca_hole",
   "op": ">=",
   "rhs": 1.5,
   "why": "Web between the RCA openings"
  },
  {
   "id": "usbc_under_rca",
   "lhs": "usbc_z + usbc_h/2 + 3",
   "op": "<=",
   "rhs": "rca_z - rca_hole/2",
   "why": "USB-C and RCA openings keep a 3 mm web"
  },
  {
   "id": "back_flange_vs_sockets",
   "lhs": "bfl_x1 + 2",
   "op": "<=",
   "rhs": "jack_x - jack_hole/2",
   "why": "Back bottom flange stops short of the socket openings"
  },
  {
   "id": "cords_above_flange",
   "lhs": "t + fl + 1",
   "op": "<=",
   "rhs": "cord_z - eth_slot/2",
   "why": "Cord cut-outs clear the bottom flange"
  },
  {
   "id": "cords_apart",
   "lhs": "cord2_x - cord1_x - cord_l",
   "op": ">=",
   "rhs": 6,
   "why": "Webs between the cord cut-outs"
  },
  {
   "id": "cords_left_of_pi",
   "lhs": "cord3_x + cord_l/2 + 10",
   "op": "<=",
   "rhs": "px0 - jack_oh",
   "why": "Cord cut-outs in the free space, clear of the Pi"
  },
  {
   "id": "back_flange_vs_pi",
   "lhs": "bfl_x1 + 2",
   "op": "<=",
   "rhs": "px0 - jack_oh",
   "why": "Back bottom flange stops short of the Pi"
  },
  {
   "id": "sd_vs_wall",
   "lhs": "px1 + sd_oh + 1",
   "op": "<=",
   "rhs": "W - t",
   "why": "microSD clears the right side"
  },
  {
   "id": "pi_vs_back_flange_y",
   "lhs": "py1",
   "op": "<=",
   "rhs": "D - hinge*t - fl",
   "why": "Pi PCB in front of the back side flanges"
  },
  {
   "id": "va_vs_knob",
   "lhs": "lens_x0 + va_l + va_w + 1",
   "op": "<=",
   "rhs": "kb_x - kb_d/2",
   "why": "Large cap leaves the viewing area clear"
  },
  {
   "id": "knobs_apart",
   "lhs": "kb_x + kb_d/2 + 3",
   "op": "<=",
   "rhs": "ks_x - ks_d/2",
   "why": "Caps 3 mm apart"
  },
  {
   "id": "small_knob_in_face",
   "lhs": "ks_x + ks_d/2",
   "op": "<=",
   "rhs": "W - 3",
   "why": "Small cap inside the face"
  },
  {
   "id": "big_knob_in_face",
   "lhs": "kb_z + kb_d/2",
   "op": "<=",
   "rhs": "H - 3",
   "why": "Large cap inside the face height"
  },
  {
   "id": "small_knob_top",
   "lhs": "ks_z + ks_d/2",
   "op": "<=",
   "rhs": "H - 3",
   "why": "Small cap inside the face height"
  },
  {
   "id": "enc_vs_screen",
   "lhs": "lens_x0 + scr_pcb_w + 1",
   "op": "<=",
   "rhs": "kb_x - enc_w/2",
   "why": "Large encoder body clears the screen board"
  },
  {
   "id": "enc_vs_pi",
   "lhs": "t + enc_d + 1",
   "op": "<=",
   "rhs": "py0",
   "why": "Encoders in front of the Pi"
  },
  {
   "id": "screen_vs_flanges",
   "lhs": "lens_z0",
   "op": ">=",
   "rhs": "2*t + 1.5 + 1",
   "why": "Screen clears the bottom flange and its nut"
  },
  {
   "id": "screen_vs_top_nut",
   "lhs": "lens_z0 + lens_h",
   "op": "<=",
   "rhs": "H - 2*t - 1.5 - 1",
   "why": "Screen clears the top flange's nut"
  },
  {
   "id": "screen_vs_side_nut",
   "lhs": "lens_x0",
   "op": ">=",
   "rhs": "2*t + gap + 1.5 + 1",
   "why": "Screen clears the left flange's nut"
  },
  {
   "id": "feet_vs_heads",
   "lhs": "head_h + 1",
   "op": "<=",
   "rhs": "feet_h",
   "why": "Feet stand taller than the screw heads"
  },
  {
   "id": "nut_catches",
   "lhs": "t + 2.5",
   "op": "<=",
   "rhs": 7,
   "why": "Encoder bushing takes the tab, washer and M7 nut"
  }
