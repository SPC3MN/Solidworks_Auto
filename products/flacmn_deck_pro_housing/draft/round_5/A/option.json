{
 "schema_version": "1.0",
 "name": "Wrap + two screwed end panels",
 "summary": "Round 5, from the owner's layout at true scale (241 x 88.5 x 100.5). One folded wrap (top, sides, floor; 3 folds) and two end panels with four inward flanges each (4 folds). Eight ISO 4762 M3 x 8 go through the wrap's top, sides and floor into clinch nuts in the flanges, which also close the wrap's open seam. The 5in DSI screen is taped behind the front panel; both encoders nut into it and the Ø57 and Ø35 caps sit proud on the shafts. The Pi + DAC sit on the floor at the back right; USB and Ethernet cords thread out through three cut-outs in the removable back panel.",
 "architecture": {
  "mechanism": "end panels screwed to the wrap; encoders nutted into the front panel; Pi on standoffs on the floor; caps pushed on",
  "layout": "screen left, knobs right on the front; Pi flat at the back right, sockets to the back, USB/Ethernet into the free space; cords out the back panel",
  "load_path": "knobs -> front panel -> flanges -> screws -> wrap -> feet -> shelf",
  "process": "laser-cut flat, 3 + 4 + 4 hand folds on perforated lines (UNTESTED recipe); clinch nuts pressed"
 },
