 "fit": [
  {
   "id": "jumpers_roof",
   "lhs": "zht + 2.5 + jumper_h + wire_bend",
   "op": "<=",
   "rhs": "H - t",
   "why": "Jumper housings and wire bends clear the top"
  },
  {
   "id": "rear_recessed",
   "lhs": "py1 + rca_len",
   "op": "<=",
   "rhs": "D - t - 0.5",
   "why": "RCA barrels stop inside the rear wall (nothing passes through it)"
  },
  {
   "id": "rca_web",
   "lhs": "rca_x1 - rca_x2 - rca_hole",
   "op": ">=",
   "rhs": 1.5,
   "why": "Web between the two RCA openings"
  },
  {
   "id": "usbc_under_rca",
   "lhs": "usbc_z + usbc_h/2 + 3",
   "op": "<=",
   "rhs": "rca_z - rca_hole/2",
   "why": "USB-C opening and RCA openings keep a 3 mm web"
  },
  {
   "id": "rim",
   "lhs": "(H - knob_hole)/2",
   "op": ">=",
   "rhs": 3.0,
   "why": "Metal left above and below the knob openings"
  },
  {
   "id": "knob_flush_mount",
   "lhs": "knob_h + knob_clear + bush_out",
   "op": "==",
   "rhs": "mount",
   "why": "Cap face flush: cap + clearance + bushing = tab set-back"
  },
  {
   "id": "shaft_inside",
   "lhs": "shaft_end",
   "op": ">=",
   "rhs": "t + 0.2",
   "why": "Shaft cut to end inside the wall, so the plate lifts in past the wall"
  },
  {
   "id": "shaft_in_cap",
   "lhs": "knob_h - shaft_end",
   "op": ">=",
   "rhs": 3,
   "why": "Shaft reaches at least 3 into the cap"
  },
  {
   "id": "enc_front_beside_pi",
   "lhs": "encF_x - enc_w/2",
   "op": ">=",
   "rhs": "px1 + 1",
   "why": "Front encoder beside the Pi and DAC"
  },
  {
   "id": "enc_front_vs_screen",
   "lhs": "encF_x - knob_d/2",
   "op": ">=",
   "rhs": "win_x + win_w/2 + 3",
   "why": "Front knob clears the screen window"
  },
  {
   "id": "enc_side_beside_pi",
   "lhs": "W - mount - t - enc_d",
   "op": ">=",
   "rhs": "px1 + sd_oh + 2",
   "why": "Side encoder body beside the Pi and its microSD card"
  },
  {
   "id": "encs_apart",
   "lhs": "encS_y - enc_w/2",
   "op": ">=",
   "rhs": "mount + t + enc_d + 1",
   "why": "Side encoder behind the front encoder"
  },
  {
   "id": "side_knob_in_face",
   "lhs": "encS_y + knob_hole/2",
   "op": "<=",
   "rhs": "D - 3",
   "why": "Side knob opening inside the side face"
  },
  {
   "id": "pi_front_vs_screen",
   "lhs": "py0",
   "op": ">=",
   "rhs": "t + scr_d + 1",
   "why": "Pi clears the screen module"
  },
  {
   "id": "left_flange_vs_pi",
   "lhs": "hinge*t + inset + 1 + fl_left",
   "op": "<=",
   "rhs": "py0 - 0.5",
   "why": "Left flange is in front of the Pi, so the jacks pass it as the plate lifts in"
  },
  {
   "id": "screen_in_face",
   "lhs": "scr_z + scr_h/2",
   "op": "<=",
   "rhs": "H - t - 1",
   "why": "Screen module fits the front wall height"
  },
  {
   "id": "nut_catches",
   "lhs": "t + 2.5",
   "op": "<=",
   "rhs": 7,
   "why": "Encoder bushing takes the tab, washer and M7 nut"
  }
 ],
