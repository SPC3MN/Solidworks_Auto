{
 "schema_version": "1.0",
 "name": "Shell + base plate, flush knobs",
 "summary": "Round 3: nothing protrudes but the feet. One folded shell (top + 4 walls) and one base plate. The plate carries the Pi stack and holds both encoders on fold-up tabs 11.5 behind the faces, so the 39 x 5 caps sit flush in Ø40 openings. Rear sockets sit 1 mm inside the wall; plugs reach in. The plate lifts in from below and takes 2 screws from underneath; the screen is taped in.",
 "architecture": {
  "mechanism": "plate with Pi, DAC and encoders lifts into the shell from below; 2 screws from underneath; caps pushed on last",
  "layout": "Pi flat, USB-C side at the rear, USB/Ethernet flush behind the left wall; front encoder right of the Pi; side encoder beside the SD end",
  "load_path": "knobs -> plate tabs -> plate -> feet -> shelf",
  "process": "laser-cut flat, 6 + 2 hand folds on perforated lines (UNTESTED recipe)"
 },
