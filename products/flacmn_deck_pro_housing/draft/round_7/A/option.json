{
 "schema_version": "1.0",
 "name": "Folded shell with back tabs + flat back plate",
 "summary": "Round 7, from the owner's layout at true scale (241 x 88.5 x 100.5). One folded shell: the front face in the centre with the top, floor and both sides folded back from it, and two tabs folded in at the back of the top and two at the back of the floor (8 folds). A flat back plate (no folds) takes four ISO 4762 M3 x 8 from the back face into clinch nuts in the tabs. The 5in DSI screen is taped behind the front face; both encoders nut into it and the Ø57 and Ø35 caps sit proud on the shafts. The Pi + DAC sit on the floor at the back right; USB and Ethernet cords thread out through three cut-outs in the back plate.",
 "architecture": {
  "mechanism": "flat back plate screwed into the shell's tabs from behind; encoders nutted into the front face; Pi on standoffs on the floor; caps pushed on",
  "layout": "screen left, knobs right on the front; Pi flat at the back right, sockets to the back, USB/Ethernet into the free space; cords out the back panel",
  "load_path": "knobs -> front face -> shell -> feet -> shelf",
  "process": "laser-cut flat; shell 8 hand folds on perforated lines (UNTESTED recipe); back plate flat; clinch nuts pressed"
 },
