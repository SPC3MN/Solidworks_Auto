  "name_rules": {
    "_comment": "Part-name regex (case-insensitive) -> library material, used when SolidWorks has no material. Confidence is 'low': Claude should confirm or override from the requirements.",
    "rules": [
      ["screw|bolt|nut|washer|fastener|eclip|circlip|retain|pin_|dowel|spring|plunger", "stainless_steel"],
      ["bearing", "stainless_polished"],
      ["o_?ring|gasket|seal|grommet|foot|bumper|tire|tyre", "rubber"],
      ["magnet", "ferrite_magnet"],
      ["window|lens|glass|clear|transparent", "polycarbonate_clear"],
      ["acrylic", "acrylic_clear"],
      ["x8020|1515|1530|3030|extrusion|rail|profile|bracket|gusset|plate", "aluminium_anodized"],
      ["pcb|board|hat|rpi|dac|pi5|zero", "pcb_green"],
      ["cable|wire|lead", "rubber"],
      ["knob|handle|grip", "pom_black"],
      ["enclosure|housing|case|lid|cover|tube|body", "aluminium_anodized"],
      ["shaft|axle|burr", "stainless_steel"]
    ],
